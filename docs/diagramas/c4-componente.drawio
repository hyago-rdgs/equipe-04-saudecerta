gn=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="330" width="440" height="74" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b style="font-size:13px"&gt;AgendamentoService&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: @Service @Transactional]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Casos de uso da agenda; implementa AgendaApi e ConsultaEstatisticaQuery.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="418" width="440" height="74" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b style="font-size:13px"&gt;Modelo de Agenda&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Domínio]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Consulta (máquina de estados), Disponibilidade, PoliticaDeConflito — RN02, RN07–RN10.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="506" width="440" height="74" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b style="font-size:13px"&gt;ConsultaJpaAdapter&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: adaptador de persistência]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Implementa ConsultaRepository; índice único de slot ativo (ADR-004).&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="594" width="440" height="74" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;e