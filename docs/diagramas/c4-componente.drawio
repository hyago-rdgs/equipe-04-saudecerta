<mxfile host="app.diagrams.net" type="device"><diagram name="C4 - Componentes da API" id="43004616"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value='&lt;b style="font-size:18px"&gt;API SaúdeCerta — Diagrama de Componentes (C4 nível 3)&lt;/b&gt;&lt;br&gt;Componentes agrupados por módulo. Setas entre módulos indicam a porta pública usada.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="-150" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:13px"&gt;Aplicação Web (SPA)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contêiner: React + TypeScript]&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="690" y="-60" width="300" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;API SaúdeCerta&lt;/b&gt; [Contêiner: Spring Boot 3]" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#438DD5;fontColor=#438DD5;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="0" y="120" width="1700" height="1080" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:13px"&gt;Cadeia de filtros de segurança&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: Spring Security]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Autentica a sessão e aplica RBAC (@PreAuthorize) antes de qualquer controller; acesso negado vira evento TentativaAcessoNegada para a Auditoria (RNF01).&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="460" y="170" width="760" height="80" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b style="font-size:13px"&gt;GlobalExceptionHandler&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: @RestControllerAdvice]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Traduz erros de domínio para HTTP (409, 422, 403).&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1300" y="170" width="370" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;REST/JSON&lt;/b&gt; [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.3;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;Módulo Cadastros&lt;/b&gt; · saudecerta.cadastro" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F7FAFE;strokeColor=#3C7FC0;fontColor=#3C7FC0;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="480" height="400" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b style="font-size:13px"&gt;PacienteController / ProfissionalController&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: @RestController]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;CRUD de pacientes, profissionais e especialidades (RF01, RF02).&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#7