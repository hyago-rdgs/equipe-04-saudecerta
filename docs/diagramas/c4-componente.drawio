lockThin;endFill=1;strokeColor=#C77700;strokeWidth=1.3;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.25;exitY=1;entryX=0.75;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c39"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1320.0" y="715"/><mxPoint x="970.0" y="715"/></Array></mxGeometry></mxCell><mxCell id="c60" value='&lt;b style="font-size:13px"&gt;Banco de dados&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contêiner: PostgreSQL 16]&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="1270" width="300" height="110" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;Todos os adaptadores de persistência&lt;/b&gt;&lt;br&gt;[JPA/JDBC, um schema por módulo]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.3;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" value='&lt;span style="font-size:11px"&gt;Dentro de cada módulo: controller → serviço → domínio; o serviço persiste por uma porta (interface) do domínio implementada pelo adaptador JPA. Setas azuis: chamadas síncronas a portas públicas; laranja tracejado: eventos.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1200" y="1220" width="500" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Componentes - Agenda (hexagonal)" id="30448004"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value='&lt;b style="font-size:18px"&gt;Módulo Agenda — detalhe em portas e adaptadores&lt;/b&gt;&lt;br&gt;As dependências apontam para o domínio; infraestrutura implementa interfaces definidas no núcleo.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="-110" width="1300" height="50" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Núcleo do módulo — sem dependência de Spring Web nem JPA&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#9CB9D9;fontColor=#3C7FC0;fontSize=11;align=center;verticalAlign=bottom;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="265" y="0" width="1110" height="470" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FFF8E6;strokeColor=#E0C27A;" vertex="1" parent="1"><mxGeometry x="830" y="30" width="260" height="400" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Adaptadores de entrada&lt;br&gt;(agenda.api)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="-45" width="250" height="40" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Portas de entrada&lt;br&gt;(agenda.application.port.in)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="-45" width="250" height="40" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Aplicação&lt;br&gt;(agenda.application)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="-45" width="250" height="40" as="geometry"/></mxCell><mxCell id="c9" value