Size=11;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="440" height="74" as="geometry"/></mxCell><mxCell id="c35" value='&lt;b style="font-size:13px"&gt;RelatorioService&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: @Service @Transactional(readOnly)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Agrega dados via ConsultaEstatisticaQuery; nunca lê conteúdo clínico (RNF08).&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="888" width="440" height="74" as="geometry"/></mxCell><mxCell id="c36" value='&lt;b style="font-size:13px"&gt;Projeções de relatório&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: records Java]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;DTOs imutáveis com totalizadores por status.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="976" width="440" height="74" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.3;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.3;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="&lt;b&gt;Módulo Segurança &amp;amp; Auditoria&lt;/b&gt; · saudecerta.seguranca" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F7FAFE;strokeColor=#3C7FC0;fontColor=#3C7FC0;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="610" y="760" width="480" height="400" as="geometry"/></mxCell><mxCell id="c40" value='&lt;b style="font-size:13px"&gt;AuthController / UsuarioController / AuditoriaController&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: @RestController]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Login/logout, usuários e perfis, consulta da trilha (RF11, RF16, RF17).&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="800" width="440" height="74" as="geometry"/></mxCell><mxCell id="c41" value='&lt;b style="font-size:13px"&gt;UsuarioService&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: @Service + UserDetailsService]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Senha com BCrypt (RNF07); bloquear usuário encerra as sessões (ADR-003).&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="888" width="440" height="74" as="geometry"/></mxCell><mxCell id="c42" value='&lt;b style="font-size:13px"&gt;AuditoriaListener&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: @ApplicationModuleListener (assíncrono)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Consome eventos e grava RegistroAuditoria com hash encadeado (