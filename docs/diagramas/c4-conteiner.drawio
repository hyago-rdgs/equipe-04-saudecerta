metry"></mxGeometry></mxCell><mxCell id="c16" value='&lt;b style="font-size:13px"&gt;Banco de dados&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contêiner: PostgreSQL 16 (H2 em dev)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Um schema por módulo; auditoria append-only; tabelas de sessão e de publicação de eventos.&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="405" y="670" width="350" height="130" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Lê e grava&lt;/b&gt;&lt;br&gt;[JPA / JDBC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.3;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value='&lt;b style="font-size:13px"&gt;Serviço de Agendamento&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contêiner futuro — Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Extração prevista no Projeto Final (ADR-001).&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#8C8496;fontColor=#555555;fontSize=12;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="830" y="230" width="220" height="110" as="geometry"/></mxCell><mxCell id="c19" value="[PF] API REST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8496;strokeWidth=1.3;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.92;exitY=0;entryX=0.5;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" targ