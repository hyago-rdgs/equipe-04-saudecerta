<mxfile host="app.diagrams.net" type="device"><diagram name="C4 - Contexto" id="1313461"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value='&lt;b style="font-size:18px"&gt;SaúdeCerta — Diagrama de Contexto (C4 nível 1)&lt;/b&gt;&lt;br&gt;Quem usa o sistema e com quais sistemas ele se relaciona.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="-90" width="900" height="50" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:13px"&gt;Recepcionista&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Cadastra pacientes e opera a agenda no balcão e no telefone.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="0" width="210" height="110" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:13px"&gt;Profissional de saúde&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Atende, registra o prontuário, prescreve e solicita exames.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="0" width="210" height="110" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:13px"&gt;Paciente&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Consulta seus agendamentos e dados; solicita consultas.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="0" width="210" height="110" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b style="font-size:13px"&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Gerencia usuários e especialidades; acompanha relatórios e auditoria.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="870" y="0" width="210" height="110" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:13px"&gt;SaúdeCerta&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Sistema de software]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Agenda sem conflitos, prontuário eletrônico somente-anexação, prescrição/exames, RBAC e trilha de auditoria de todo acesso ao prontuário.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="140" y="300" width="880" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Cadastra pacientes;&lt;br&gt;marca, remarca e cancela&lt;/b&gt;&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.3;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.028;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;Consulta histórico, registra&lt;br&gt;atendimento, prescreve&lt;/b&gt;&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.3;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.335;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Vê os próprios&lt;br&gt;agendamentos e dados&lt;/b&gt;&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.3;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.642;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;Gerencia usuários;&lt;br&gt;consulta auditoria e relatórios&lt;/b&gt;&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.3;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.949;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value='&lt;b style="font-size:13px"&gt;Faturamento / Convênios&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Sistema externo — futuro]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Fora do escopo; ponto de extensão (RNF05).&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#8C8496;fontColor=#555555;fontSize=12;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="150" y="560" width="240" height="100" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b style="font-size:13px"&gt;Laboratórios&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Sistema externo — futuro]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Recebe solicitações e devolve laudos.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#8C8496;fontColor=#555555;fontSize=12;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="460" y="560" width="240" height="100" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b style="font-size:13px"&gt;Telemedicina&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Sistema externo — futuro]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Teleconsulta integrada à agenda.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#8C8496;fontColor=#555555;fontSize=12;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="770" y="560" width="240" height="100" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8496;strokeWidth=1.3;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.148;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="[futuro] REST / eventos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8496;strokeWidth=1.3;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strok