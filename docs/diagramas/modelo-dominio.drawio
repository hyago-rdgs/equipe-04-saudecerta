)&lt;br&gt;+ inativar()' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4CF;strokeColor=#444444;fontColor=#111111;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="240" height="150" as="geometry"/></mxCell><mxCell id="c12" value='&lt;div style="text-align:center"&gt;&lt;i style="font-size:10px"&gt;«entidade»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Especialidade&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;- id: Long&lt;br&gt;- nome: String' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontColor=#111111;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="300" y="270" width="240" height="80" as="geometry"/></mxCell><mxCell id="c13" value='&lt;div style="text-align:center"&gt;&lt;i style="font-size:10px"&gt;«raiz de agregado»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Disponibilidade&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;- id: Long&lt;br&gt;- profissionalId: Long&lt;br&gt;- diaSemana: DayOfWeek&lt;br&gt;- horaInicio, horaFim: LocalTime&lt;br&gt;- duracao: Duration&lt;hr size="1"&gt;+ gerarHorarios(data): List&lt;br&gt;+ contem(dataHora): boolean' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4CF;strokeColor=#444444;fontColor=#111111;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="240" height="180" as="geometry"/></mxCell><mxCell id="c14" value='&lt;div style="text-align:center"&gt;&lt;i style="font-size:10px"&gt;«raiz de agregado»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Consulta&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;- id: Long&lt;br&gt;- pacienteId: Long&lt;br&gt;- profissionalId: Long&lt;br&gt;- dataHora: LocalDateTime&lt;br&gt;- status: StatusConsulta&lt;br&gt;- versao: Long&lt;hr size="1"&gt;+ remarcar(novaDataHora)&lt;br&gt;+ cancelar()&lt;br&gt;+ realizar()' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4CF;strokeColor=#444444;fontColor=#11111